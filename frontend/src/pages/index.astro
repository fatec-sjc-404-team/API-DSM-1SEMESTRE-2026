---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Negado pelo Banco — Crédito Inclusivo">
  <div
    x-data="apiStatus()"
    x-init="verificar()"
    class="flex flex-col items-center justify-center min-h-[70vh] text-center gap-6"
  >
    <h1 class="text-4xl font-bold text-gray-900">Negado pelo Banco</h1>
    <p class="text-lg text-gray-500 max-w-xl">
      Crédito Inclusivo com Dados do BCB: identificando regiões com alto potencial de crédito sem
      acesso ao sistema financeiro tradicional.
    </p>

    <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-100 text-sm font-medium">
      <template x-if="status === 'verificando'">
        <span class="flex items-center gap-2 text-gray-500">
          <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></span>
          Verificando conexão com a API...
        </span>
      </template>
      <template x-if="status === 'online'">
        <span class="flex items-center gap-2 text-green-700">
          <span class="w-2 h-2 rounded-full bg-green-500"></span>
          API conectada
        </span>
      </template>
      <template x-if="status === 'offline'">
        <span class="flex items-center gap-2 text-red-700">
          <span class="w-2 h-2 rounded-full bg-red-500"></span>
          API indisponível — rodando em modo offline
        </span>
      </template>
    </div>

    <div class="flex gap-3 mt-2">
      <a
        href="/dashboard"
        class="px-5 py-2 rounded-lg bg-gray-900 text-white text-sm font-medium hover:bg-gray-700 transition-colors"
      >
        Dashboard
      </a>
      <a
        href="/relatorios"
        class="px-5 py-2 rounded-lg border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50 transition-colors"
      >
        Relatórios
      </a>
    </div>
  </div>
</Layout>

<script>
  // @ts-nocheck
  import Alpine from 'alpinejs';

  const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'http://localhost:8000';

  Alpine.data('apiStatus', () => ({
    status: 'verificando',

    async verificar() {
      try {
        const res = await fetch(`${apiBase}/health`, { signal: AbortSignal.timeout(5000) });
        this.status = res.ok ? 'online' : 'offline';
      } catch {
        this.status = 'offline';
      }
    },
  }));
</script>
